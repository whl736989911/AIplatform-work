    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/search",
      "stage": "source",
      "success_status": 200,
      "summary": "指定 KB 检索，200",
      "authorization": "read；body 含 query、match_count、embedding_model"
    },
    {
      "method": "POST",
      "path": "/workflows/{id}/trigger-registrations",
      "stage": "source",
      "success_status": 201,
