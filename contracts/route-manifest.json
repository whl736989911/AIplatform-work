{
  "manifest_version": 1,
  "base_path": "/api/v1",
  "source": {
    "path": "WorkBuddy-开发文档-审计优化版.md",
    "sha256": "9410524281dca177aa23b8e105eb48a3e5b66ba5ec5cbcfea3560c96506d98f5",
    "original_route_count": 62
  },
  "routes": [
    {
      "method": "POST",
      "path": "/auth/login",
      "stage": "source",
      "success_status": 200,
      "summary": "登录，200；返回 access_token、token_type、expires_in",
      "authorization": "X-Tenant-Slug；限流、统一失败响应；不记录密码/token"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "stage": "source",
      "success_status": 201,
      "summary": "消费邀请并建立用户，201",
      "authorization": "请求含 invitation_token、display_name、password；邀请绑定租户/身份且一次性消费"
    },
    {
      "method": "POST",
      "path": "/tenants",
      "stage": "source",
      "success_status": 201,
      "summary": "创建企业，201",
      "authorization": "独立平台管理面身份；不得由普通租户 JWT 调用"
    },
    {
      "method": "GET",
      "path": "/tenants/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "企业基本信息，200",
      "authorization": "当前租户成员仅得安全摘要；管理信息另受 admin 限制"
    },
    {
      "method": "POST",
      "path": "/workflows",
      "stage": "source",
      "success_status": 201,
      "summary": "创建草稿，201",
      "authorization": "有创建能力的成员；请求 name、可选 description、definition"
    },
    {
      "method": "GET",
      "path": "/workflows",
      "stage": "source",
      "success_status": 200,
      "summary": "可见工作流列表，200",
      "authorization": "成员只得已发布执行目录；创建者/admin 可含草稿"
    },
    {
      "method": "GET",
      "path": "/workflows/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "工作流详情，200，含 ETag",
      "authorization": "管理者得 definition/版本指针；普通执行者只得已发布输入规范等最小投影"
    },
    {
      "method": "PUT",
      "path": "/workflows/{id}",
      "stage": "source",
      "success_status": 201,
      "summary": "保存新版本，201，含 ETag",
      "authorization": "创建者/admin；If-Match；body 含 base_version_id、definition、可选 change_summary"
    },
    {
      "method": "POST",
      "path": "/workflows/{id}/activate",
      "stage": "source",
      "success_status": 200,
      "summary": "显式发布，200，含 ETag",
      "authorization": "创建者/admin；If-Match；body 为 version_id；禁止绕过 proposal"
    },
    {
      "method": "POST",
      "path": "/workflows/{id}/rollback",
      "stage": "source",
      "success_status": 201,
      "summary": "复制历史版本并发布新版本，201，含 ETag",
      "authorization": "创建者/admin；If-Match；body 为 version_id"
    },
    {
      "method": "GET",
      "path": "/workflows/{id}/versions",
      "stage": "source",
      "success_status": 200,
      "summary": "版本列表，200",
      "authorization": "创建者/admin；标记 active/candidate 及历史引用"
    },
    {
      "method": "GET",
      "path": "/workflows/{id}/versions/{version_id}",
      "stage": "source",
      "success_status": 200,
      "summary": "指定不可变版本，200",
      "authorization": "创建者/admin；版本必须属于路径中的工作流"
    },
    {
      "method": "POST",
      "path": "/workflows/{id}/execute",
      "stage": "source",
      "success_status": 202,
      "summary": "接受执行，202",
      "authorization": "已发布工作流的租户成员或授权触发主体；body 为 inputs；外部写必须有幂等键"
    },
    {
      "method": "GET",
      "path": "/executions",
      "stage": "source",
      "success_status": 200,
      "summary": "本人执行列表，200",
      "authorization": "用户范围默认本人；admin 的受控范围须有管理目的并审计"
    },
    {
      "method": "GET",
      "path": "/executions/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "执行详情，200",
      "authorization": "发起者或受控 admin；不向审批人默认提供此完整视图"
    },
    {
      "method": "POST",
      "path": "/executions/{id}/resume",
      "stage": "source",
      "success_status": 200,
      "summary": "提交审批决定，200",
      "authorization": "当前有效候选审批人；body 含 approval_request_id、decision、token；CAS"
    },
    {
      "method": "POST",
      "path": "/executions/{id}/cancel",
      "stage": "source",
      "success_status": 202,
      "summary": "接受取消，202",
      "authorization": "发起者或受控 admin；body 含 reason；终态返回 409"
    },
    {
      "method": "POST",
      "path": "/executions/{id}/reconciliations",
      "stage": "source",
      "success_status": 200,
      "summary": "外部写结果证据对账，200",
      "authorization": "仅受控租户 admin；只对 waiting_reconciliation step；CAS"
    },
    {
      "method": "GET",
      "path": "/approval-requests",
      "stage": "source",
      "success_status": 200,
      "summary": "本人待审批/已审批列表，200",
      "authorization": "仅当前候选审批人/决定人及受控 admin 的限定视图"
    },
    {
      "method": "GET",
      "path": "/approval-requests/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "限定审批详情，200",
      "authorization": "只展示审批必要材料，不返回明文 token 或无关执行 payload"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "stage": "source",
      "success_status": 200,
      "summary": "本人的异步任务列表，200",
      "authorization": "便于响应丢失后发现已创建任务"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "任务状态与授权结果，200",
      "authorization": "发起者、任务绑定授权主体或受控 admin"
    },
    {
      "method": "POST",
      "path": "/chat",
      "stage": "source",
      "success_status": 200,
      "summary": "私有会话中的单轮回答，200",
      "authorization": "成员仅访问本人会话；工具执行不得绕过工作流执行/审批边界"
    },
    {
      "method": "GET",
      "path": "/audit-logs",
      "stage": "source",
      "success_status": 200,
      "summary": "审计查询，200",
      "authorization": "受控 admin；脱敏、只读、分页，查询本身留痕"
    },
    {
      "method": "GET",
      "path": "/usage",
      "stage": "source",
      "success_status": 200,
      "summary": "用量查询，200",
      "authorization": "成员看本人，admin 看租户聚合"
    },
    {
      "method": "POST",
      "path": "/workflows/{id}/improvement-proposals",
      "stage": "source",
      "success_status": 202,
      "summary": "生成建议，202，返回 job_id",
      "authorization": "创建者/admin；服务端固定当前 base_version_id/hash"
    },
    {
      "method": "GET",
      "path": "/improvement-proposals",
      "stage": "source",
      "success_status": 200,
      "summary": "可见建议列表，200",
      "authorization": "工作流管理者看完整治理信息；被分配审阅人只得审核所需投影"
    },
    {
      "method": "GET",
      "path": "/improvement-proposals/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "建议详情、reviews 和指标，200",
      "authorization": "明确 candidate_version_id、requires_manual_shadow 和样本不足原因"
    },
    {
      "method": "POST",
      "path": "/improvement-proposals/{id}/decisions",
      "stage": "source",
      "success_status": 200,
      "summary": "登记审核，200",
      "authorization": "有审核资格且非创建者的人类成员；body 为 decision=approved/rejected、comment"
    },
    {
      "method": "POST",
      "path": "/improvement-proposals/{id}/promote",
      "stage": "source",
      "success_status": 200,
      "summary": "请求状态推进，200，含 ETag",
