    },
    {
      "method": "POST",
      "path": "/knowledge-bases",
      "stage": "source",
      "success_status": 201,
      "summary": "创建 KB，201",
      "authorization": "成员可建 personal；enterprise/department 需适用管理权限"
    },
    {
      "method": "GET",
      "path": "/knowledge-bases/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "KB 元信息，200",
      "authorization": "read；模型与固定 revision 可见，凭据不可见"
    },
    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/archive",
      "stage": "source",
      "success_status": 200,
      "summary": "归档 KB，200",
      "authorization": "KB admin；设置 archived_at，后续文档/chunk 检索不可见"
    },
    {
      "method": "GET",
      "path": "/knowledge-bases/{id}/acl",
      "stage": "source",
      "success_status": 200,
      "summary": "读取授权表，200",
      "authorization": "KB admin，不向仅有 read 的用户枚举成员信息"
    },
    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/acl",
      "stage": "source",
      "success_status": 201,
      "summary": "添加授权，201",
      "authorization": "KB admin；user_id/department_id 恰好一个，permission 为 read/write/admin"
    },
    {
      "method": "PUT",
      "path": "/knowledge-bases/{id}/acl/{acl_id}",
      "stage": "source",
      "success_status": 200,
      "summary": "原子修改授权级别，200",
      "authorization": "KB admin；body 仅含 permission；acl 必须属于该 KB"
    },
    {
      "method": "DELETE",
      "path": "/knowledge-bases/{id}/acl/{acl_id}",
