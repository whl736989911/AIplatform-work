    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/uploads",
      "stage": "source",
      "success_status": 201,
      "summary": "申请受限文件上传，201",
      "authorization": "write；请求 filename、mime_type、size_bytes；返回绑定租户/KB 的 upload_id"
    },
    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/uploads/{upload_id}/complete",
      "stage": "source",
      "success_status": 200,
      "summary": "完成上传校验，200",
      "authorization": "原上传主体且仍有 write；校验大小、魔数、扫描；返回绑定式 file_ref"
    },
    {
      "method": "POST",
      "path": "/knowledge-bases/{id}/documents",
      "stage": "source",
      "success_status": 202,
      "summary": "建档与索引，202，返回 job_id",
      "authorization": "write；body 含 upload_id、file_ref、title"
    },
    {
      "method": "GET",
      "path": "/knowledge-bases/{id}/documents",
      "stage": "source",
      "success_status": 200,
