      "method": "GET",
      "path": "/marketplace/installations/{id}",
      "stage": "source",
      "success_status": 200,
      "summary": "本租户安装状态，200",
      "authorization": "安装发起者/工作流管理者"
    },
    {
      "method": "POST",
      "path": "/marketplace/installations/{id}/upgrade",
      "stage": "source",
      "success_status": 202,
