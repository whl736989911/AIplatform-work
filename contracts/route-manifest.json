    },
    {
      "method": "DELETE",
      "path": "/workflows/{id}/trigger-registrations/{registration_id}",
      "stage": "source",
      "success_status": 200,
      "summary": "撤销注册与后续授权，200",
      "authorization": "工作流管理者"
    },
    {
      "method": "POST",
