# =============================================================================
# Octop + WorkBuddy — production deployment settings (Linux host)
#
# Machine-readable sample. Copy and fill in; NEVER commit the filled copy:
#   cp deploy/production.env.example deploy/.env
#   deploy/scripts/init-secrets.sh          # generates deploy/secrets/* (mode 0400)
#   docker compose -f deploy/compose.production.yml --env-file deploy/.env config
#
# Consumed by docker compose interpolation AND sourced by the host-side
# operational scripts (backup / restore / gates), which is why every value is a
# shell-safe KEY=value. No credential belongs in this file: passwords, tokens and
# keys live as files under deploy/secrets and are mounted at /run/secrets.
# =============================================================================

# --- images: digest-pinned only ---------------------------------------------
# Format: <registry>/<repository>@sha256:<64 hex>. Tags (":latest", ":1.2.3") are
# rejected by deploy/scripts/verify-deployment-policy.sh before rollout.
# Take the reference from the published release digest, or from
# `docker inspect --format '{{index .RepoDigests 0}}' <locally-built-tag>`.
OCTOP_IMAGE=
# PostgreSQL server_version MUST equal the contracts/dependency-lock.json tag
# (`17.6` of postgres:17.6-bookworm) and the image MUST ship the pgvector
# extension. dependency-lock.json pins the upstream postgres digests below; a
# pgvector-enabled build of the same PostgreSQL 17.6 is required because the
# locked upstream image cannot load the `vector` extension:
#   index sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3
#   amd64 sha256:45cd22f8d32e189d245403954882f88e7a8714301fda80dab6da90f1265b25a3
# POSTGRES_IMAGE must therefore be a digest-pinned pgvector/pgvector PostgreSQL
# 17.6 build (or an internal mirror of it). The runtime gate rejects any image
# whose observed server_version differs from OCTOP_EXPECTED_DATABASE_SERVER_VERSION.
POSTGRES_IMAGE=
# Redis tag in dependency-lock.json: 7.4.5-alpine (index digest
# sha256:bb186d083732f669da90be8b0f975a37812b15e913465bb14d845db72a4e3e08,
# amd64 sha256:0302cccee2b2043e61b497c8f4075467c5f7ba27a9f38be7e092634f2734baed).
REDIS_IMAGE=
# Vault tag in dependency-lock.json: 2.1.1 (index digest
# sha256:47f14a6acb98f48d798a07df7c83f23a6e636e1cf724c5f8ff165cb32667a1e2,
# amd64 sha256:8af37ae9d45e4a0fac48ab700e0d99efc4c2d6cd84354a869f2147f1d3abab46).
# License BUSL-1.1: legal review is still an open gate, so the Vault service is
# behind `--profile vault` and must stay disabled until that gate is closed.
VAULT_IMAGE=

# --- expected runtime versions (gate inputs, from contracts/dependency-lock.json)
OCTOP_EXPECTED_DATABASE_SERVER_VERSION=17.6
OCTOP_EXPECTED_REDIS_VERSION=7.4.5
OCTOP_EXPECTED_VAULT_VERSION=2.1.1

# --- listeners ---------------------------------------------------------------
# 127.0.0.1 keeps the API off the public interface: put a TLS-terminating,
# authenticating reverse proxy in front of it. 0.0.0.0 is a deliberate
# dual-stack/edge-network decision, never a default.
OCTOP_BIND_ADDRESS=127.0.0.1
OCTOP_PORT=8088
OCTOP_LOG_LEVEL=info
OCTOP_ENABLE_DASHBOARD=true
OCTOP_ENABLE_API_DOCS=false
# Requires the setup password during first-run /setup (keep true in production).
OCTOP_REQUIRE_SETUP_PASSWORD=true
# Comma-separated allowed origins when the dashboard is served from another host.
OCTOP_CORS_ORIGINS=

# --- control-plane database --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=octop
POSTGRES_USER=octop
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_STATEMENT_TIMEOUT=60s
POSTGRES_IDLE_TX_TIMEOUT=120s
POSTGRES_SLOW_QUERY_MS=2000
POSTGRES_SHM_SIZE=256m
# Runtime uids/gids of the official images (volume-init chowns the volumes).
POSTGRES_UID=999
POSTGRES_GID=999

# --- broker / rate limiting --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=512mb
# noeviction: never silently drop queued work under memory pressure
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_UID=999
REDIS_GID=1000

# --- private S3-compatible object storage ------------------------------------
# Adapter configuration only. Credentials are read from deploy/secrets/aws_*.
# Leave ENDPOINT/BUCKET empty to keep object storage unconfigured: the
# dependency probe then reports `blocked` instead of pretending success.
OBJECT_STORAGE_KIND=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- embeddings ---------------------------------------------------------------
# Locked revision of BAAI/bge-m3: 5617a9f61b028005a4858fdac845db406aefb181.
# Empty keeps indexing/retrieval disabled (quality gate open); a non-matching
# value is rejected by the dependency probe.
EMBEDDING_MODEL_REVISION=

# --- Vault workload identity (placeholders; profile `vault`) ------------------
# VAULT_ADDR is only set when the vault profile runs. Role/secret ids are read
# from files (deploy/secrets/vault_role_id, vault_secret_id) — never inline.
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_UI=false
VAULT_LOG_LEVEL=warn
# Keep false while dependency-lock.json marks the Vault gate blocked; setting it
# true makes the app treat a missing/unhealthy Vault as fatal instead of absent.
VAULT_WORKLOAD_IDENTITY_REQUIRED=false
VAULT_UID=100
VAULT_GID=1000

# --- app / job identities and resource bounds --------------------------------
OCTOP_UID=10001
OCTOP_GID=10001
OCTOP_APP_CPUS=2.0
OCTOP_APP_MEMORY=2g
OCTOP_APP_MEMORY_RESERVATION=512m
OCTOP_JOB_CPUS=1.0
OCTOP_JOB_MEMORY=1g
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
POSTGRES_MEMORY_RESERVATION=512m
REDIS_CPUS=1.0
REDIS_MEMORY=768m
VAULT_CPUS=0.5
VAULT_MEMORY=512m
OCTOP_INIT_CPUS=0.5
OCTOP_INIT_MEMORY=256m
OCTOP_MIGRATION_WAIT_SECONDS=120
OCTOP_LOG_MAX_SIZE=10m
OCTOP_LOG_MAX_FILES=3
# Host directory holding the mounted secret files (relative to deploy/).
OCTOP_SECRETS_DIR=./secrets

# --- first admin bootstrap (profile `bootstrap`, run once) --------------------
OCTOP_ADMIN_USERNAME=admin
OCTOP_ADMIN_DISPLAY_NAME=Admin

# --- backup / restore / gates (host-side scripts) -----------------------------
# Where pg_dump custom-format archives land on the host.
OCTOP_BACKUP_DIR=./backups
# Retention: keep at least MIN_COUNT archives and never delete one younger than
# RETENTION_DAYS. Both are enforced by backup-postgres.sh and re-checked by
# restore-readiness-gate.sh.
OCTOP_BACKUP_RETENTION_DAYS=14
OCTOP_BACKUP_RETENTION_MIN_COUNT=7
# Restore readiness fails when the newest archive is older than this.
OCTOP_BACKUP_MAX_AGE_HOURS=26
# Optional offsite copy target (s3://bucket/prefix). Requires the `aws` CLI on
# the host; when set, a missing CLI or a failed upload fails the backup run.
OCTOP_BACKUP_S3_URL=
# Scratch database used to prove an archive is restorable, then dropped.
OCTOP_RESTORE_SCRATCH_DB=octop_restore_check
# Hard guard: restore-postgres.sh refuses to run without this set to "yes".
OCTOP_ALLOW_RESTORE=no
